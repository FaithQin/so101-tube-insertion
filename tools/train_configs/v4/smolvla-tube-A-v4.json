        },
        "sharpness": {
          "weight": 1.0,
          "type": "SharpnessJitter",
          "kwargs": {
            "sharpness": [
              0.5,
              1.5
            ]
          }
        },
        "affine": {
          "weight": 1.0,
          "type": "RandomAffine",
          "kwargs": {
            "degrees": [
