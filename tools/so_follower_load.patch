+    def _relieve_gripper(self) -> None:
+        # LOCAL PATCH (capstone): the gripper's overload fault is NOT a latch -- it
+        # clears ~0.5 s after strain drops (measured Aug 14). During a fault every
+        # status-bearing read raises, but sync_write needs no status packet, so an
+        # "open slightly" command still gets through. Send it, give the servo a
+        # beat, and the fault clears on its own. All-night power cycles were the
+        # crash-with-strain-held death spiral, not a hardware latch.
+        relief = getattr(self, "_last_gripper_present", None)
+        target = (relief + 2.0) if relief is not None else 50.0
+        try:
+            self.bus.sync_write("Goal_Position", {"gripper": target})
+        except Exception:
+            pass
+        time.sleep(0.6)
